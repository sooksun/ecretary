# Restored by `pod install`; 300 MB of vendored sources do not belong in git.
# The Xcode project + Podfile.lock ARE tracked, so the install is reproducible.
apps/mobile/ios/Pods/
apps/mobile/ios/*.xcworkspace/xcuserdata/
apps/mobile/ios/*.xcodeproj/xcuserdata/
# Gradle cache inside the local Expo module
apps/mobile/modules/*/android/.gradle/

