# ─────────────────────────────────────────────────────────
# M-Secretary — Local Dev Environment
# Copy to .env and adjust before running services
#
# PRODUCTION CHECKLIST (vars marked [PROD] must be changed):
#   JWT_SECRET          — generate: openssl rand -hex 32
#   S3_ACCESS_KEY / S3_SECRET_KEY — real MinIO/S3 credentials
#   MINIO_ROOT_USER / MINIO_ROOT_PASSWORD — match S3 creds above
#   DATABASE_URL        — production Postgres connection string
#   CORS_ORIGINS        — comma-separated list of allowed frontend origins
# ─────────────────────────────────────────────────────────

# API
API_PORT=3000
API_GLOBAL_PREFIX=api/v1
NODE_ENV=development

# JWT [PROD: generate with: openssl rand -hex 32]
JWT_SECRET=change-me-dev-secret
JWT_EXPIRES_IN=7d

# CORS — comma-separated list of allowed origins (empty = localhost:8081 only)
# CORS_ORIGINS=https://your.production.domain
CORS_ORIGINS=

# Database (Postgres)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/msecretary?schema=public

# Redis / BullMQ
REDIS_HOST=localhost
REDIS_PORT=6379

# Object Storage (MinIO / S3) [PROD: replace minioadmin credentials]
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
S3_BUCKET=msecretary
S3_FORCE_PATH_STYLE=true

# Upload limits
MAX_CHUNK_SIZE_MB=50

# Worker
WORKER_CONCURRENCY_TRANSCRIBE=2
WORKER_CONCURRENCY_SUMMARY=1

# AI provider — selects which TranscriptionProvider the worker loads.
#   mock     deterministic Thai segments, no audio touched (Phase A)
#   whisper  POSTs chunk audio to the in-network whisper service
#   openai   reserved (Phase 4 LLM summary uses a separate switch)
AI_PROVIDER=mock
# AI_PROVIDER=whisper

# Whisper service endpoint (only used when AI_PROVIDER=whisper)
# Inside docker compose --profile ai use http://whisper:9001
# Running whisper locally bare → http://localhost:9001
WHISPER_ENDPOINT=http://localhost:9001
WHISPER_LANGUAGE=th
# WHISPER_TIMEOUT_MS=1800000

# LLM provider for summary worker — mock | claude
LLM_PROVIDER=mock
LLM_MODEL=claude-sonnet-4-6
# Required when LLM_PROVIDER=claude (production AI summaries)
# ANTHROPIC_API_KEY=sk-ant-...

# LINE Messaging API (M7) — used by /meetings/:id/share + reminders.
# Get a Channel Access Token from https://developers.line.biz/console/
# When unset, push calls log a dryrun message and return false (no error).
# LINE_CHANNEL_ACCESS_TOKEN=
