# Mobile env template. Copy to .env (dev) or .env.production (release builds).
# `EXPO_PUBLIC_*` vars are baked into the JS bundle at build time.

# Dev — point to your laptop's LAN IP (NOT localhost — phones can't reach
# the host's localhost). Find with `ipconfig` (Win) or `ifconfig` (mac/linux).
# For USB tethering, set up `adb reverse tcp:3000 tcp:3000` and use localhost.
EXPO_PUBLIC_API_BASE_URL=http://192.168.1.36:3000/api/v1

# Release builds — copy this template to .env.production and replace with the
# public HTTPS URL of the production API:
#   EXPO_PUBLIC_API_BASE_URL=https://api.your-domain.com/api/v1
