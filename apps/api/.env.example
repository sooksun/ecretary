# Local API service env (override the root .env if needed)
API_PORT=3000
API_GLOBAL_PREFIX=api/v1
NODE_ENV=development

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/msecretary?schema=public

REDIS_HOST=localhost
REDIS_PORT=6379

S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=msecretary
S3_FORCE_PATH_STYLE=true

MAX_CHUNK_SIZE_MB=50

JWT_SECRET=change-me-dev-secret
JWT_EXPIRES_IN=7d
